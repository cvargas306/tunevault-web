<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="stylesheet" href="/style.css" />
  <title>Edit <%= song.title %> — TuneVault Web</title>
</head>
<body>
  <a href="/song/<%= song.id %>">&larr; Back to song</a>

  <h1>Edit Song</h1>

  <form action="/song/<%= song.id %>/edit" method="POST">
    <label for="title">Title:</label><br />
    <input type="text" id="title" name="title" value="<%= song.title %>" required /><br /><br />

    <label for="artist">Artist:</label><br />
    <input type="text" id="artist" name="artist" value="<%= song.artist %>" required /><br /><br />

    <label for="album">Album (optional):</label><br />
    <input type="text" id="album" name="album" value="<%= song.album || '' %>" /><br /><br />

    <label for="duration">Duration (e.g. 3:45):</label><br />
    <input type="text" id="duration" name="duration" value="<%= song.duration %>" required
           pattern="[0-9]+:[0-5][0-9]" title="Use m:ss, for example 3:45" /><br /><br />

    <label for="genre_id">Genre:</label><br />
    <select id="genre_id" name="genre_id" required>
      <% genres.forEach(function (genre) { %>
        <option value="<%= genre.id %>" <%= genre.id === song.genre_id ? "selected" : "" %>>
          <%= genre.name %>
        </option>
      <% }); %>
    </select><br /><br />

    <button type="submit">Save Changes</button>
  </form>
</body>
</html>