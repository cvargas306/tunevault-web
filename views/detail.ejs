<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="stylesheet" href="/style.css" />
  <title><%= song.title %> — TuneVault Web</title>
</head>
<body>
  <a href="/">&larr; Back to catalog</a>

  <h1><%= song.title %></h1>
  <p><strong>Artist:</strong> <%= song.artist %></p>
  <p><strong>Album:</strong> <%= song.album || "Single" %></p>
  <p><strong>Genre:</strong> <%= song.genre %></p>
  <p><strong>Duration:</strong> <%= song.duration %></p>
  <p><a href="/song/<%= song.id %>/edit">Edit this song</a></p>
    <form action="/song/<%= song.id %>/delete" method="POST"
        onsubmit="return confirm('Delete this song? This cannot be undone.');">
    <button type="submit">Delete this song</button>
  </form>
</body>
</html>